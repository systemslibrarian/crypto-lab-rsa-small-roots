{
  "name": "crypto-lab-rsa-small-roots",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:maintenance && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run build && vitest run",
    "test:browser": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:claims": "playwright test e2e/claims.spec.ts",
    "test:maintenance": "node --test tests/maintenance-controls.node.mjs",
    "test:mutations": "node scripts/mutations.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
